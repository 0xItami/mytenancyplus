MTP_ENVIRONMENT=local
MTP_DATABASE_URL=postgresql+asyncpg://mytenancyplus:mytenancyplus@postgres:5432/mytenancyplus
MTP_REDIS_URL=redis://redis:6379/0
MTP_JWT_SECRET=replace-with-at-least-32-random-characters
MTP_ACCESS_TOKEN_TTL_MINUTES=30
MTP_REFRESH_TOKEN_TTL_DAYS=30
MTP_CORS_ORIGINS=["http://localhost:3002"]
MTP_PUBLIC_APP_URL=http://localhost:3002
MTP_BILLING_WEBHOOK_SECRET=replace-with-a-provider-webhook-secret
MTP_STORAGE_ROOT=/app/data/documents
MTP_MAX_DOCUMENT_SIZE_BYTES=10485760
MTP_RATE_LIMIT_REQUESTS=120
MTP_RATE_LIMIT_WINDOW_SECONDS=60
